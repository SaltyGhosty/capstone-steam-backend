# Copia este archivo como .env y rellena los valores. .env NUNCA se sube a git.

# --- Base de datos (PostgreSQL local en 5432; con docker-compose usa el puerto 5433) ---
DB_URL=jdbc:postgresql://localhost:5432/capstone_steam
DB_USER=postgres
DB_PASSWORD=

# --- JWT: clave en Base64 de al menos 32 bytes ---
# Generar en PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
# Access token de 15 min y refresh token de 7 días
JWT_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P7D
# Purga de refresh_tokens (opcional): cron de Spring y margen tras la caducidad de la familia
# REFRESH_PURGE_CRON=0 30 3 * * *
# REFRESH_PURGE_GRACE=P1D

# --- Gmail SMTP: requiere verificación en 2 pasos y una "contraseña de aplicación" ---
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=
# Nombre con el que llegan los correos (por defecto ARCADE)
MAIL_FROM_NAME=ARCADE
# Espera máxima con el SMTP en milisegundos (conexión, lectura y escritura). Los fallos de conexión se reintentan 3 veces
# MAIL_TIMEOUT=15000

# --- Brevo (API HTTP): con clave, los correos salen por HTTPS y no por SMTP. Necesaria en Render free,
# que bloquea los puertos SMTP. El remitente (MAIL_FROM o MAIL_USERNAME) tiene que estar verificado en Brevo ---
BREVO_API_KEY=

# --- Verificación de email ---
# true (por defecto): crear cuenta manda un enlace y no se puede iniciar sesión hasta pulsarlo
# EMAIL_VERIFICATION_REQUIRED=true
# Validez del enlace (ISO-8601, por defecto 24 horas)
# EMAIL_VERIFICATION_TTL=P1D

# --- Eliminar cuenta ---
# Margen entre pedir la baja y anonimizar la cuenta (ISO-8601, por defecto 14 días)
# ACCOUNT_DELETION_GRACE=P14D
# Cuándo corre la tarea que anonimiza (cron de Spring, por defecto 04:15 cada día)
# ACCOUNT_DELETION_CRON=0 15 4 * * *

# --- Administrador inicial (se crea al arrancar si ADMIN_PASSWORD no está vacío) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@capstone-steam.local
ADMIN_PASSWORD=

# --- Puerto HTTP (el 8080 puede estar ocupado) ---
SERVER_PORT=8081

# --- CORS (URL del frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- URL del frontend para los botones de los correos (si falta, se usa CORS_ALLOWED_ORIGINS) ---
FRONTEND_URL=http://localhost:5173

# --- Portadas subidas como archivo (Cloudinary) ---
# cloudinary://<api_key>:<api_secret>@<cloud_name> (vacío = subida desactivada)
CLOUDINARY_URL=

# --- Chat recomendador (OpenRouter) ---
# Clave de https://openrouter.ai/keys (vacía = el asistente responde "no disponible", sin llamadas de red).
# Los modelos :free piden activar en la cuenta de OpenRouter la opción de privacidad que permite usarlos.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free,google/gemma-4-31b-it:free
