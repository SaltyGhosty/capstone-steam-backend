# Copia este archivo como host.env y rellénalo. host.env no se sube a git.
# Los secretos (JWT_SECRET, contraseña de la BD, Gmail, admin) siguen en el .env de la raíz.

# Dirección pública (tiene que ser un dominio de tu cuenta de Cloudflare)
PUBLIC_HOST=arcade.tudominio.com

# Nombre del túnel de Cloudflare
TUNNEL_NAME=arcade

# Base de datos de producción (separada de la de desarrollo, capstone_steam)
DB_NAME=arcade

# Puertos locales: el backend de desarrollo usa 8080/8081 y Vite 5173
BACKEND_PORT=8090
WEB_PORT=8088
